# copy to srv1.yml and fill in
admin_user: admin
monitor_ip: 192.0.2.10
# local paths the full backup should skip
backup_exclude_extra: []
# open or closed
signup_state: closed
# where admin@runv.club and friends are forwarded
mail_forward_to: you@example.org
# monthly costs for /about. empty means it just says the admin pays
about_costs:
  - {what: "the server", cost: "€00 a month"}
about_total: "€00"
