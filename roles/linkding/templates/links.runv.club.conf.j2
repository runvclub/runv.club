server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name links.runv.club;

    ssl_certificate     /etc/letsencrypt/live/runv.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runv.club/privkey.pem;
    include snippets/runv-headers.conf;

    # app assets first, then the favicons and previews linkding fetched
    location ~ ^/static/(?<file>.+)$ {
        root /;
        try_files /opt/linkding/app/static/$file /var/lib/linkding/favicons/$file /var/lib/linkding/previews/$file =404;
        include snippets/runv-headers.conf;
        add_header Content-Security-Policy "sandbox" always;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:9090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
