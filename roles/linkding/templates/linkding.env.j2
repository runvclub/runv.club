DJANGO_SETTINGS_MODULE=bookmarks.settings.prod
HOST_NAME=links.runv.club
LD_CSRF_TRUSTED_ORIGINS=https://links.runv.club
LD_DISABLE_LOGIN_FORM=True
LD_ENABLE_OIDC=True
OIDC_OP_AUTHORIZATION_ENDPOINT=https://git.runv.club/login/oauth/authorize
OIDC_OP_TOKEN_ENDPOINT=https://git.runv.club/login/oauth/access_token
OIDC_OP_USER_ENDPOINT=https://git.runv.club/login/oauth/userinfo
OIDC_OP_JWKS_ENDPOINT=https://git.runv.club/login/oauth/keys
OIDC_RP_CLIENT_ID={{ linkding_oidc.client_id }}
OIDC_RP_CLIENT_SECRET={{ linkding_oidc.client_secret }}
OIDC_USERNAME_CLAIM=preferred_username
