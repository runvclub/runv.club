def cmd_add(args, conf, db):
    key = args.key
    if args.key_file:
        with open(args.key_file) as f:
            key = f.read()
    if not key:
        die("need --key or --key-file")
    try:
        name = runvcheck.username(args.name)
        mail = runvcheck.email(args.email)
        key, fingerprint = runvcheck.ssh_key(key)
    except ValueError as e:
        die(str(e))
    create(conf, db, name, mail, key, fingerprint)


def create(conf, db, name, mail, key, fingerprint):
    """Make the account. Also used by runv-queue approve."""
    if find(db, name) or exists_on_system(name):
        die(f"{name} is taken")

    m = conf["members"]
    uid = next_uid(m.getint("uid_min"))
    run("useradd", "--create-home", "--skel", m["skel"], "--shell", m["shell"],
        "--uid", str(uid), "--user-group", "--groups", m["group"], name)
    try:
        home = pwd.getpwnam(name).pw_dir
        os.chmod(home, 0o711)

        ssh = os.path.join(home, ".ssh")
        os.makedirs(ssh, mode=0o700, exist_ok=True)
        with open(os.path.join(ssh, "authorized_keys"), "w") as f:
            f.write(key + "\n")
        os.chmod(os.path.join(ssh, "authorized_keys"), 0o600)
        run("chown", "-R", f"{name}:{name}", ssh)

        write_slice(uid, conf["limits"])
        set_quota(name, conf)
    except Exception:
        # half an account is worse than none, the home is brand new so -r is fine
        run("userdel", "--remove", name, check=False)
        drop_slice(uid)
        raise

    db.append({
        "username": name,
        "uid": uid,
        "email": mail,
        "key_fingerprint": fingerprint,
        "status": "active",
        "created_at": now().isoformat(),
    })
    save_db(db)
    gemini_sync(db)
    if i2p_sync(db):
        save_db(db)
    try:
        forgejo_add(name, mail, key)
    except Exception as e:
        print(f"warning: no git account yet ({e}). run: runv-user forgejo {name}", file=sys.stderr)
    try:
        irc_add(name)
    except Exception as e:
        print(f"warning: no bouncer account yet ({e}). run: runv-user irc {name}", file=sys.stderr)
    # apps under systemd --user keep running after logout
    run("loginctl", "enable-linger", name, check=False)
    run("systemctl", "start", "--no-block", "runv-tun-cert.service", check=False)
    log(f"add {name} uid={uid} key={fingerprint}")

    sent = runvmail.send(mail, "Welcome to runv.club", welcome_text(name, find(db, name).get("i2p")))
    print(f"{name} created (uid {uid}, {fingerprint})" + ("" if sent else ", welcome mail not sent"))


def cmd_list(args, conf, db):
    if not db:
        print("no members yet")
        return
    for m in sorted(db, key=lambda m: m["created_at"]):
        print(f"{m['username']:<16} {m['status']:<10} {m['created_at'][:10]}  {m['email']}")


def cmd_show(args, conf, db):
    m = member_or_die(db, args.name)
    print(json.dumps(m, indent=2, sort_keys=True))


def cmd_suspend(args, conf, db):
    m = member_or_die(db, args.name, "active")
    run("usermod", "--lock", "--expiredate", "1", m["username"])
    stop_sessions(m["username"])
    # web, gemini and gopher can't get in anymore
    os.chmod(pwd.getpwnam(m["username"]).pw_dir, 0o700)
    m["status"] = "suspended"
    m["suspended_at"] = now().isoformat()
    if args.reason:
        m["suspend_reason"] = args.reason
    save_db(db)
    gemini_sync(db)
    i2p_sync(db)
    services_off(m["username"])
    log(f"suspend {m['username']} reason={args.reason or '-'}")
    print(f"{m['username']} suspended")


def cmd_unsuspend(args, conf, db):
    m = member_or_die(db, args.name, "suspended")
    run("usermod", "--unlock", "--expiredate", "", m["username"])
    os.chmod(pwd.getpwnam(m["username"]).pw_dir, 0o711)
    m["status"] = "active"
    m.pop("suspended_at", None)
    m.pop("suspend_reason", None)
    save_db(db)
    gemini_sync(db)
    i2p_sync(db)
    services_on(m["username"])
    log(f"unsuspend {m['username']}")
    print(f"{m['username']} active again")


def cmd_delete(args, conf, db):
    m = member_or_die(db, args.name, "active", "suspended")
    name = m["username"]
    home = pwd.getpwnam(name).pw_dir
    busy = mounts_under(home)
    if busy:
        die(f"something is mounted under {home}: {', '.join(busy)}. unmount it first, no lazy umount")

    run("usermod", "--lock", "--expiredate", "1", name)
    stop_sessions(name)
    gemini_unmount(name)
    services_off(name)

    quarantine = conf["delete"]["quarantine"]
    stamp = now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(quarantine, f"{name}-{stamp}")
    os.rename(home, dest)
    if i2p_tunnel_off(name):
        i2p_reload()
    if os.path.exists(i2p_key(name)):
        shutil.move(i2p_key(name), os.path.join(dest, ".i2p-key.dat"))

    run("loginctl", "disable-linger", name, check=False)
    run("setquota", "-u", name, "0", "0", "0", "0", "/", check=False)
    run("crontab", "-r", "-u", name, check=False)
    evict(m["uid"], dest)
    run("userdel", name)
    drop_slice(m["uid"])
    for spool in (f"/var/mail/{name}", f"/var/spool/mail/{name}"):
        if os.path.isfile(spool) and not os.path.islink(spool):
            shutil.move(spool, os.path.join(dest, ".mail"))

    m["status"] = "deleted"
    m["deleted_at"] = now().isoformat()
    m["quarantine"] = dest
    save_db(db)
    run("systemctl", "start", "--no-block", "runv-tun-cert.service", check=False)
    log(f"delete {name} home moved to {dest}")
    days = conf["delete"].getint("days")
    print(f"{name} deleted, home kept in {dest} for {days} days")


def purge_one(m, db, conf):
    path = m.get("quarantine")
    root = conf["delete"]["quarantine"].rstrip("/") + "/"
    if path and os.path.exists(path):
        if not path.startswith(root):
            die(f"refusing to remove {path}, it is outside {root}")
        busy = mounts_under(path)
        if busy:
            die(f"something is mounted under {path}: {', '.join(busy)}")
        shutil.rmtree(path)
    feeds_remove(m["username"])
    try:
        forgejo_remove(m["username"])
    except Exception as e:
        die(f"could not remove the git account of {m['username']}: {e}")
    linkding_remove(m["username"])
    if runvirc.available():
        runvirc.delete(m["username"])
    ntfy_remove(m["username"])
    guestbook(m["username"], "purge")
    db.remove(m)
    log(f"purge {m['username']}")
    print(f"{m['username']} purged")


def cmd_purge(args, conf, db):
    if args.now:
        purge_one(member_or_die(db, args.now, "deleted"), db, conf)
        save_db(db)
        return
    days = conf["delete"].getint("days")
    cutoff = now() - dt.timedelta(days=days)
    due = [m for m in db if m["status"] == "deleted"
           and dt.datetime.fromisoformat(m["deleted_at"]) < cutoff]
    for m in due:
        purge_one(m, db, conf)
    if due:
        save_db(db)


