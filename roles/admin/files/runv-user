import base64
import configparser
import datetime as dt
import fcntl
import json
import os
import pwd
import grp
import re
import secrets
import hashlib
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/local/lib/runv")
import runvcheck  # noqa: E402
import runvmail  # noqa: E402
import runvirc  # noqa: E402
import runvsecret  # noqa: E402

CONF = "/etc/runv/runv.conf"
DB = "/var/lib/runv/members.json"
LOCK = "/var/lib/runv/.lock"
LOG = "/var/log/runv/users.log"
SLICE_DIR = "/etc/systemd/system/user-{uid}.slice.d"
GEMINI_USERS = "/var/gemini/users"
I2P_TUNNELS = "/etc/i2pd/tunnels.d"
I2P_KEYS = "/var/lib/i2pd/runv"
FORGEJO_API = "http://127.0.0.1:3000/api/v1"
FORGEJO_TOKEN = "/etc/runv/forgejo.token"
LINKDING_DIR = "/opt/linkding/app"
LINKDING_ENV = "/etc/runv/linkding.env"

def die(msg):
    print(f"runv-user: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def run(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, text=True, capture_output=True, **kw)


def log(line):
    with open(LOG, "a") as f:
        f.write(f"{now().isoformat()} {line}\n")


def load_conf():
    c = configparser.ConfigParser(interpolation=None)
    if not c.read(CONF):
        die(f"missing {CONF}")
    return c


def load_db():
    try:
        with open(DB) as f:
            return json.load(f)
    except FileNotFoundError:
        return []


def save_db(db):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(DB))
    with os.fdopen(fd, "w") as f:
        json.dump(db, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, DB)
    mail_sync(db)


SUBMITTERS = "/etc/postfix/runv-submitters"
SUSPENDED = "/etc/postfix/runv-suspended.regexp"
LISTS = "/etc/postfix/runv-lists"
LIST_DIR = "/var/lib/runv-lists"


def write_if_changed(path, text):
    try:
        with open(path) as f:
            if f.read() == text:
                return False
    except FileNotFoundError:
        pass
    with open(path + ".new", "w") as f:
        f.write(text)
    os.chmod(path + ".new", 0o644)
    os.replace(path + ".new", path)
    return True


def wanted_lists(home, uid):
    """The list names in ~/.lists: a small plain file of theirs, or nothing."""
    try:
        fd = os.open(os.path.join(home, ".lists"), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return set()
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 4096:
            return set()
        return set(f.read(4096).decode("utf-8", "replace").split())


def mail_sync(db):
    """Who may send mail (active members), whose mail bounces (suspended
    ones) and who is on which list. Returns True if anything changed."""
    if not os.path.exists(LISTS):
        return False
    active = sorted(m["username"] for m in db if m["status"] == "active")
    suspended = sorted(m["username"] for m in db if m["status"] == "suspended")
    changed = write_if_changed(SUBMITTERS, "".join(n + "\n" for n in active))
    text = f"/^({'|'.join(suspended)})@/    error:5.2.1 this account is suspended\n" if suspended else ""
    if write_if_changed(SUSPENDED, text):
        run("postfix", "reload", check=False)
        changed = True
    with open(LISTS) as f:
        lists = re.findall(r"^list\+([a-z0-9_-]+):", f.read(), re.M)
    subs = {name: [] for name in lists}
    for m in db:
        if m["status"] != "active":
            continue
        try:
            home = pwd.getpwnam(m["username"]).pw_dir
        except KeyError:
            continue
        for name in wanted_lists(home, m["uid"]) & set(lists):
            subs[name].append(m["username"])
    os.makedirs(LIST_DIR, mode=0o755, exist_ok=True)
    for name, who in subs.items():
        changed |= write_if_changed(os.path.join(LIST_DIR, name), "".join(n + "\n" for n in sorted(who)))
    return changed


def find(db, name):
    for m in db:
        if m["username"] == name:
            return m
    return None


def member_or_die(db, name, *statuses):
    m = find(db, name)
    if not m:
        die(f"{name} is not a member account")
    if statuses and m["status"] not in statuses:
        die(f"{name} is {m['status']}")
    return m


def exists_on_system(name):
    for lookup in (pwd.getpwnam, grp.getgrnam):
        try:
            lookup(name)
            return True
        except KeyError:
            pass
    return False


def set_quota(name, conf):
    q = conf["limits"]
    run("setquota", "-u", name, q["quota_soft"], q["quota_hard"],
        q.get("inodes_soft", "0"), q.get("inodes_hard", "0"), "/")


SHARED = ("/srv/square", "/var/tmp", "/tmp")


def evict(uid, dest):
    """uids get reused, so whatever a deleted member left in the shared
    dirs goes to their quarantine, or the next member would inherit it and
    have it count on their quota. Directories of theirs that still hold
    other people's files stay, handed to root."""
    for top in SHARED:
        if not os.path.isdir(top):
            continue
        keep = os.path.join(dest, "." + top.strip("/").replace("/", "-"))
        for root, dirs, files, fd in os.fwalk(top, topdown=False, follow_symlinks=False):
            rel = os.path.relpath(root, top)
            for n in files:
                try:
                    st = os.stat(n, dir_fd=fd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                if st.st_uid != uid:
                    continue
                target = os.path.normpath(os.path.join(keep, rel, n))
                os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
                os.rename(n, target, src_dir_fd=fd)
            for n in dirs:
                try:
                    st = os.stat(n, dir_fd=fd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                if st.st_uid != uid or not stat.S_ISDIR(st.st_mode):
                    continue
                try:
                    os.rmdir(n, dir_fd=fd)
                except OSError:
                    os.chown(n, 0, 0, dir_fd=fd, follow_symlinks=False)
                    os.chmod(n, 0o1777, dir_fd=fd, follow_symlinks=False)


def next_uid(start):
    used = {p.pw_uid for p in pwd.getpwall()} | {g.gr_gid for g in grp.getgrall()}
    uid = start
    while uid in used:
        uid += 1
    return uid


def mounts_under(path):
    out = run("findmnt", "-rn", "-o", "TARGET").stdout.split()
    path = path.rstrip("/")
    return [t for t in out if t == path or t.startswith(path + "/")]


def stop_sessions(name):
    run("loginctl", "terminate-user", name, check=False)
    run("pkill", "-KILL", "-u", name, check=False)


def write_slice(uid, limits):
    d = SLICE_DIR.format(uid=uid)
    os.makedirs(d, exist_ok=True)
    with open(f"{d}/50-runv.conf", "w") as f:
        f.write(
            "[Slice]\n"
            f"MemoryMax={limits['memory']}\n"
            f"MemorySwapMax={limits['swap']}\n"
            f"TasksMax={limits['tasks']}\n"
            f"CPUQuota={limits['cpu']}\n"
        )
    run("systemctl", "daemon-reload")


def drop_slice(uid):
    shutil.rmtree(SLICE_DIR.format(uid=uid), ignore_errors=True)
    run("systemctl", "daemon-reload")



# molly-brown won't follow symlinks out of its docroot, so each active
# member's public_gemini is bind mounted read-only under /var/gemini/users.
# read-only means an rm -rf through the mount can never reach the home.
def gemini_target(name):
    return os.path.join(GEMINI_USERS, name)


def gemini_mounted(name):
    return gemini_target(name) in run("findmnt", "-rn", "-o", "TARGET").stdout.split()


def gemini_unmount(name):
    target = gemini_target(name)
    if gemini_mounted(name):
        out = run("umount", target, check=False)
        if out.returncode != 0:
            die(f"could not unmount {target}: {out.stderr.strip()}. no lazy umount, sort it out by hand")
    if os.path.isdir(target) and not os.listdir(target):
        os.rmdir(target)


def gemini_mount(name, uid):
    src = os.path.join(pwd.getpwnam(name).pw_dir, "public_gemini")
    try:
        st = os.lstat(src)
    except FileNotFoundError:
        return f"{name}: no public_gemini"
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid:
        return f"{name}: public_gemini is not a directory owned by {name}, skipped"
    if gemini_mounted(name):
        return None
    target = gemini_target(name)
    os.makedirs(target, mode=0o755, exist_ok=True)
    run("mount", "--bind", src, target)
    run("mount", "-o", "remount,bind,ro,nosuid,nodev,noexec", target)
    return None


def gemini_sync(db):
    os.makedirs(GEMINI_USERS, mode=0o755, exist_ok=True)
    active = {m["username"]: m["uid"] for m in db if m["status"] == "active"}
    problems = []
    for name, uid in active.items():
        msg = gemini_mount(name, uid)
        if msg:
            problems.append(msg)
    for name in os.listdir(GEMINI_USERS):
        if name not in active:
            gemini_unmount(name)
    return problems


# one i2pd server tunnel per member. the key file is the address, so it
# is never deleted while the account exists, only the tunnel comes and goes
def i2p_conf(name):
    return os.path.join(I2P_TUNNELS, f"runv-{name}.conf")


def i2p_key(name):
    return os.path.join(I2P_KEYS, f"{name}.dat")


def i2p_tunnel_on(name):
    if not os.path.isdir(I2P_TUNNELS):
        return False
    text = (
        f"[runv-{name}]\n"
        "type = http\n"
        "host = 127.0.0.1\n"
        "port = 7980\n"
        f"hostoverride = {name}\n"
        f"keys = runv/{name}.dat\n"
    )
    path = i2p_conf(name)
    if os.path.exists(path) and open(path).read() == text:
        return False
    with open(path, "w") as f:
        f.write(text)
    return True


def i2p_tunnel_off(name):
    if os.path.exists(i2p_conf(name)):
        os.remove(i2p_conf(name))
        return True
    return False


def i2p_reload():
    run("systemctl", "reload", "i2pd", check=False)


def i2p_address(name, wait=0):
    """b32 address from the key file: sha256 of the public destination."""
    path = i2p_key(name)
    deadline = time.time() + wait
    while not os.path.exists(path) and time.time() < deadline:
        time.sleep(1)
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        data = f.read()
    cert_len = int.from_bytes(data[385:387], "big")
    dest = data[:387 + cert_len]
    b32 = base64.b32encode(hashlib.sha256(dest).digest()).decode().lower().rstrip("=")
    return f"{b32}.b32.i2p"


def i2p_sync(db):
    changed = False
    active = {m["username"] for m in db if m["status"] == "active"}
    for name in active:
        changed |= i2p_tunnel_on(name)
    if os.path.isdir(I2P_TUNNELS):
        for f in os.listdir(I2P_TUNNELS):
            if f.startswith("runv-") and f.endswith(".conf") and f[5:-5] not in active:
                os.remove(os.path.join(I2P_TUNNELS, f))
                changed = True
    if changed:
        i2p_reload()
    filled = False
    for m in db:
        if m["status"] == "active" and not m.get("i2p"):
            m["i2p"] = i2p_address(m["username"], wait=30 if changed else 0)
            if m["i2p"]:
                filled = True
                i2p_note(m["username"], m["i2p"])
    return filled


def i2p_note(name, address):
    """Leave the address where the member can read it."""
    path = os.path.join(pwd.getpwnam(name).pw_dir, ".i2p-address")
    with open(path, "w") as f:
        f.write(address + "\n")
    os.chmod(path, 0o644)
    shutil.chown(path, name, name)


# git.runv.club. members get the same name and ssh key as on the shell
def forgejo(method, path, body=None):
    try:
        token = open(FORGEJO_TOKEN).read().strip()
    except FileNotFoundError:
        return None
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(FORGEJO_API + path, data=data, method=method, headers={
        "Authorization": f"token {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise RuntimeError(f"forgejo said {e.code} to {method} {path}: {e.read().decode()[:200]}")


def forgejo_add(name, mail, key):
    if forgejo("GET", f"/users/{name}"):
        return "already there"
    password = secrets.token_urlsafe(18)
    forgejo("POST", "/admin/users", {
        "username": name, "email": mail, "password": password,
        "must_change_password": True, "send_notify": False,
    })
    forgejo("POST", f"/admin/users/{name}/keys", {"title": "runv", "key": key})
    path = os.path.join(pwd.getpwnam(name).pw_dir, ".forgejo-password")
    with open(path, "w") as f:
        f.write(password + "\n")
    os.chmod(path, 0o600)
    shutil.chown(path, name, name)
    return "created"


def forgejo_login(name, allowed):
    if forgejo("GET", f"/users/{name}"):
        forgejo("PATCH", f"/admin/users/{name}",
                {"login_name": name, "source_id": 0, "prohibit_login": not allowed})


def forgejo_remove(name):
    if forgejo("GET", f"/users/{name}"):
        forgejo("DELETE", f"/admin/users/{name}?purge=true")


# links.runv.club. accounts appear on first login through git.runv.club,
# so here we only switch them off, back on, or delete them
def linkding(code):
    if not os.path.exists(LINKDING_ENV):
        return
    env = dict(os.environ)
    with open(LINKDING_ENV) as f:
        for line in f:
            if "=" in line:
                k, v = line.rstrip("\n").split("=", 1)
                env[k] = v
    run("runuser", "-u", "linkding", "--", "/opt/linkding/venv/bin/python", "manage.py",
        "shell", "-c", "from django.contrib.auth.models import User\n" + code,
        cwd=LINKDING_DIR, env=env, check=False)


def linkding_active(name, active):
    linkding(f"User.objects.filter(username={name!r}).update(is_active={active})")


def linkding_remove(name):
    linkding(f"User.objects.filter(username={name!r}).delete()")


# irc.runv.club. the password lives in ~/.config/runv/irc-token, where
# `chat` and senpai pick it up
def irc_add(name):
    if not runvirc.available():
        return "no bouncer here"
    if runvirc.exists(name):
        return "already there"
    runvsecret.save(name, "irc-token", runvirc.create(name))
    return "created"


def irc_on(name):
    if runvirc.available() and runvirc.exists(name):
        runvsecret.save(name, "irc-token", runvirc.new_password(name))


def irc_off(name):
    if runvirc.available():
        runvirc.lock(name)


# ntfy.runv.club users only exist once a member asks for a token
def ntfy_remove(name):
    if os.path.exists("/usr/bin/ntfy"):
        run("runuser", "-u", "_ntfy", "--", "ntfy", "user", "remove", name, check=False)


# feeds.runv.club. accounts appear on first login through git.runv.club.
# miniflux names them by email, so they're found by the forgejo user id
def feeds_sql(sql, name):
    if not os.path.exists("/usr/bin/miniflux"):
        return
    u = forgejo("GET", f"/users/{name}")
    if not u:
        return
    # psql only fills in :'oid' in sql it reads, not in -c
    run("runuser", "-u", "postgres", "--", "psql", "-q", "-d", "miniflux",
        "-v", f"oid={u['id']}", "-v", "ON_ERROR_STOP=1", input=sql + ";\n", cwd="/", check=False)


def feeds_logout(name):
    feeds_sql("delete from user_sessions where user_id in "
              "(select id from users where openid_connect_id = :'oid')", name)


def feeds_remove(name):
    feeds_sql("delete from users where openid_connect_id = :'oid'", name)


GBCTL = "/usr/local/lib/runv-guestbook/gbctl.py"


def guestbook(name, action):
    if os.path.exists(GBCTL):
        out = run("runuser", "-u", "runvgb", "--", "python3", "-I", GBCTL, name, action, check=False)
        if out.returncode != 0:
            raise RuntimeError(f"guestbook {action}: {out.stderr.strip()[:200]}")


def services_off(name):
    for step in (lambda: forgejo_login(name, False), lambda: linkding_active(name, False),
                 lambda: irc_off(name), lambda: ntfy_remove(name), lambda: feeds_logout(name),
                 lambda: guestbook(name, "block")):
        try:
            step()
        except Exception as e:
            print(f"warning: {e}", file=sys.stderr)


def services_on(name):
    for step in (lambda: forgejo_login(name, True), lambda: linkding_active(name, True),
                 lambda: irc_on(name), lambda: guestbook(name, "unblock")):
        try:
            step()
        except Exception as e:
            print(f"warning: {e}", file=sys.stderr)

