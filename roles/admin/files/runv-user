#!/usr/bin/python3 -I
"""Manage runv.club member accounts.

    runv-user add NAME --email ADDR (--key 'ssh-ed25519 ...' | --key-file FILE)
    runv-user list
    runv-user show NAME
    runv-user suspend NAME [--reason TEXT]
    runv-user unsuspend NAME
    runv-user delete NAME
    runv-user purge [--now NAME]
    runv-user gemini-sync
    runv-user i2p-sync
    runv-user forgejo NAME      (re)create a member's git account
    runv-user irc NAME          (re)create a member's bouncer account

Only accounts created by this tool can be touched. Deleted homes go to a
quarantine dir first and are removed by `purge` after the configured days.
"""

