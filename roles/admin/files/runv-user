#!/usr/bin/python3 -I
"""Manage runv.club member accounts.

    runv-user add NAME --email ADDR (--key 'ssh-ed25519 ...' | --key-file FILE)
    runv-user list
    runv-user show NAME
    runv-user suspend NAME [--reason TEXT]
    runv-user unsuspend NAME
    runv-user delete NAME
    runv-user purge [--now NAME]
    runv-user gemini-sync
    runv-user i2p-sync
    runv-user forgejo NAME      (re)create a member's git account
    runv-user irc NAME          (re)create a member's bouncer account

Only accounts created by this tool can be touched. Deleted homes go to a
quarantine dir first and are removed by `purge` after the configured days.
"""

import argparse
import base64
import configparser
import datetime as dt
import fcntl
import json
import os
import pwd
import grp
import secrets
import hashlib
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/local/lib/runv")
import runvcheck  # noqa: E402
import runvmail  # noqa: E402
import runvirc  # noqa: E402
import runvsecret  # noqa: E402

CONF = "/etc/runv/runv.conf"
DB = "/var/lib/runv/members.json"
LOCK = "/var/lib/runv/.lock"
LOG = "/var/log/runv/users.log"
SLICE_DIR = "/etc/systemd/system/user-{uid}.slice.d"
GEMINI_USERS = "/var/gemini/users"
I2P_TUNNELS = "/etc/i2pd/tunnels.d"
I2P_KEYS = "/var/lib/i2pd/runv"
FORGEJO_API = "http://127.0.0.1:3000/api/v1"
FORGEJO_TOKEN = "/etc/runv/forgejo.token"
LINKDING_DIR = "/opt/linkding/app"
LINKDING_ENV = "/etc/runv/linkding.env"

def die(msg):
    print(f"runv-user: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def run(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, text=True, capture_output=True, **kw)


def log(line):
    with open(LOG, "a") as f:
        f.write(f"{now().isoformat()} {line}\n")


def load_conf():
    c = configparser.ConfigParser(interpolation=None)
    if not c.read(CONF):
        die(f"missing {CONF}")
    return c


def load_db():
    try:
        with open(DB) as f:
            return json.load(f)
    except FileNotFoundError:
        return []


def save_db(db):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(DB))
    with os.fdopen(fd, "w") as f:
        json.dump(db, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, DB)


def find(db, name):
    for m in db:
        if m["username"] == name:
            return m
    return None


def member_or_die(db, name, *statuses):
    m = find(db, name)
    if not m:
        die(f"{name} is not a member account")
    if statuses and m["status"] not in statuses:
        die(f"{name} is {m['status']}")
    return m


def exists_on_system(name):
    for lookup in (pwd.getpwnam, grp.getgrnam):
        try:
            lookup(name)
            return True
        except KeyError:
            pass
    return False


def next_uid(start):
    used = {p.pw_uid for p in pwd.getpwall()} | {g.gr_gid for g in grp.getgrall()}
    uid = start
    while uid in used:
        uid += 1
    return uid


def mounts_under(path):
    out = run("findmnt", "-rn", "-o", "TARGET").stdout.split()
    path = path.rstrip("/")
    return [t for t in out if t == path or t.startswith(path + "/")]


def stop_sessions(name):
    run("loginctl", "terminate-user", name, check=False)
    run("pkill", "-KILL", "-u", name, check=False)


def write_slice(uid, limits):
    d = SLICE_DIR.format(uid=uid)
    os.makedirs(d, exist_ok=True)
    with open(f"{d}/50-runv.conf", "w") as f:
        f.write(
            "[Slice]\n"
            f"MemoryMax={limits['memory']}\n"
            f"MemorySwapMax={limits['swap']}\n"
            f"TasksMax={limits['tasks']}\n"
            f"CPUQuota={limits['cpu']}\n"
        )
    run("systemctl", "daemon-reload")


def drop_slice(uid):
    shutil.rmtree(SLICE_DIR.format(uid=uid), ignore_errors=True)
    run("systemctl", "daemon-reload")



# molly-brown won't follow symlinks out of its docroot, so each active
# member's public_gemini is bind mounted read-only under /var/gemini/users.
# read-only means an rm -rf through the mount can never reach the home.
def gemini_target(name):
    return os.path.join(GEMINI_USERS, name)


def gemini_mounted(name):
    return gemini_target(name) in run("findmnt", "-rn", "-o", "TARGET").stdout.split()


def gemini_unmount(name):
    target = gemini_target(name)
    if gemini_mounted(name):
        out = run("umount", target, check=False)
        if out.returncode != 0:
            die(f"could not unmount {target}: {out.stderr.strip()}. no lazy umount, sort it out by hand")
    if os.path.isdir(target) and not os.listdir(target):
        os.rmdir(target)


def gemini_mount(name, uid):
    src = os.path.join(pwd.getpwnam(name).pw_dir, "public_gemini")
    try:
        st = os.lstat(src)
    except FileNotFoundError:
        return f"{name}: no public_gemini"
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid:
        return f"{name}: public_gemini is not a directory owned by {name}, skipped"
    if gemini_mounted(name):
        return None
    target = gemini_target(name)
    os.makedirs(target, mode=0o755, exist_ok=True)
    run("mount", "--bind", src, target)
    run("mount", "-o", "remount,bind,ro,nosuid,nodev,noexec", target)
    return None


def gemini_sync(db):
    os.makedirs(GEMINI_USERS, mode=0o755, exist_ok=True)
    active = {m["username"]: m["uid"] for m in db if m["status"] == "active"}
    problems = []
    for name, uid in active.items():
        msg = gemini_mount(name, uid)
        if msg:
            problems.append(msg)
    for name in os.listdir(GEMINI_USERS):
        if name not in active:
            gemini_unmount(name)
    return problems


# one i2pd server tunnel per member. the key file is the address, so it
# is never deleted while the account exists, only the tunnel comes and goes
def i2p_conf(name):
    return os.path.join(I2P_TUNNELS, f"runv-{name}.conf")


def i2p_key(name):
    return os.path.join(I2P_KEYS, f"{name}.dat")


def i2p_tunnel_on(name):
    if not os.path.isdir(I2P_TUNNELS):
        return False
    text = (
        f"[runv-{name}]\n"
        "type = http\n"
        "host = 127.0.0.1\n"
        "port = 7980\n"
        f"hostoverride = {name}\n"
        f"keys = runv/{name}.dat\n"
    )
    path = i2p_conf(name)
    if os.path.exists(path) and open(path).read() == text:
        return False
    with open(path, "w") as f:
        f.write(text)
    return True


def i2p_tunnel_off(name):
    if os.path.exists(i2p_conf(name)):
        os.remove(i2p_conf(name))
        return True
    return False


def i2p_reload():
    run("systemctl", "reload", "i2pd", check=False)


def i2p_address(name, wait=0):
    """b32 address from the key file: sha256 of the public destination."""
    path = i2p_key(name)
    deadline = time.time() + wait
    while not os.path.exists(path) and time.time() < deadline:
        time.sleep(1)
    if not os.path.exists(path):
        return None
    with open(path, "rb") as f:
        data = f.read()
    cert_len = int.from_bytes(data[385:387], "big")
    dest = data[:387 + cert_len]
    b32 = base64.b32encode(hashlib.sha256(dest).digest()).decode().lower().rstrip("=")
    return f"{b32}.b32.i2p"


def i2p_sync(db):
    changed = False
    active = {m["username"] for m in db if m["status"] == "active"}
    for name in active:
        changed |= i2p_tunnel_on(name)
    if os.path.isdir(I2P_TUNNELS):
        for f in os.listdir(I2P_TUNNELS):
            if f.startswith("runv-") and f.endswith(".conf") and f[5:-5] not in active:
                os.remove(os.path.join(I2P_TUNNELS, f))
                changed = True
    if changed:
        i2p_reload()
    filled = False
    for m in db:
        if m["status"] == "active" and not m.get("i2p"):
            m["i2p"] = i2p_address(m["username"], wait=30 if changed else 0)
            if m["i2p"]:
                filled = True
                i2p_note(m["username"], m["i2p"])
    return filled


def i2p_note(name, address):
    """Leave the address where the member can read it."""
    path = os.path.join(pwd.getpwnam(name).pw_dir, ".i2p-address")
    with open(path, "w") as f:
        f.write(address + "\n")
    os.chmod(path, 0o644)
    shutil.chown(path, name, name)


# git.runv.club. members get the same name and ssh key as on the shell
def forgejo(method, path, body=None):
    try:
        token = open(FORGEJO_TOKEN).read().strip()
    except FileNotFoundError:
        return None
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(FORGEJO_API + path, data=data, method=method, headers={
        "Authorization": f"token {token}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise RuntimeError(f"forgejo said {e.code} to {method} {path}: {e.read().decode()[:200]}")


def forgejo_add(name, mail, key):
    if forgejo("GET", f"/users/{name}"):
        return "already there"
    password = secrets.token_urlsafe(18)
    forgejo("POST", "/admin/users", {
        "username": name, "email": mail, "password": password,
        "must_change_password": True, "send_notify": False,
    })
    forgejo("POST", f"/admin/users/{name}/keys", {"title": "runv", "key": key})
    path = os.path.join(pwd.getpwnam(name).pw_dir, ".forgejo-password")
    with open(path, "w") as f:
        f.write(password + "\n")
    os.chmod(path, 0o600)
    shutil.chown(path, name, name)
    return "created"


def forgejo_login(name, allowed):
    if forgejo("GET", f"/users/{name}"):
        forgejo("PATCH", f"/admin/users/{name}",
                {"login_name": name, "source_id": 0, "prohibit_login": not allowed})


def forgejo_remove(name):
    if forgejo("GET", f"/users/{name}"):
        forgejo("DELETE", f"/admin/users/{name}?purge=true")


# links.runv.club. accounts appear on first login through git.runv.club,
# so here we only switch them off, back on, or delete them
def linkding(code):
    if not os.path.exists(LINKDING_ENV):
        return
    env = dict(os.environ)
    with open(LINKDING_ENV) as f:
        for line in f:
            if "=" in line:
                k, v = line.rstrip("\n").split("=", 1)
                env[k] = v
    run("runuser", "-u", "linkding", "--", "/opt/linkding/venv/bin/python", "manage.py",
        "shell", "-c", "from django.contrib.auth.models import User\n" + code,
        cwd=LINKDING_DIR, env=env, check=False)


def linkding_active(name, active):
    linkding(f"User.objects.filter(username={name!r}).update(is_active={active})")


def linkding_remove(name):
    linkding(f"User.objects.filter(username={name!r}).delete()")


# irc.runv.club. the password lives in ~/.config/runv/irc-token, where
# `chat` and senpai pick it up
def irc_add(name):
    if not runvirc.available():
        return "no bouncer here"
    if runvirc.exists(name):
        return "already there"
    runvsecret.save(name, "irc-token", runvirc.create(name))
    return "created"


def irc_on(name):
    if runvirc.available() and runvirc.exists(name):
        runvsecret.save(name, "irc-token", runvirc.new_password(name))


def irc_off(name):
    if runvirc.available():
        runvirc.lock(name)


def services_off(name):
    for step in (lambda: forgejo_login(name, False), lambda: linkding_active(name, False),
                 lambda: irc_off(name)):
        try:
            step()
        except Exception as e:
            print(f"warning: {e}", file=sys.stderr)


def services_on(name):
    for step in (lambda: forgejo_login(name, True), lambda: linkding_active(name, True),
                 lambda: irc_on(name)):
        try:
            step()
        except Exception as e:
            print(f"warning: {e}", file=sys.stderr)

def welcome_text(name, i2p=None):
    i2p_line = f"    http://{i2p}/\n        ~/public_i2p\n" if i2p else ""
    return f"""Hi {name},

Your runv.club account is ready. Log in with the key you sent us:

    ssh {name}@runv.club

Your pages are already up, with a placeholder in each one. Edit the
folder under each address to change it:

    https://runv.club/~{name}/
        ~/public_html
    gemini://runv.club/~{name}/
        ~/public_gemini
    gopher://runv.club/1/~{name}
        ~/public_gopher
{i2p_line}
Git lives at https://git.runv.club with the same name and key. The
first password is in ~/.forgejo-password and you'll be asked to change
it. Bookmarks are at https://links.runv.club, you log in there with your
git account.

Type `help` once you're in, or `runv` for your dashboard. Type `chat`
to talk to the rest of us in #runv on tilde.chat. It goes through our
bouncer, so you won't miss what was said while you were away, and the
same account works in the browser at https://chat.runv.club (the
password is in ~/.config/runv/irc-token).

The rules are at https://runv.club/rules

See you around,
runv.club
"""

def cmd_add(args, conf, db):
    key = args.key
    if args.key_file:
        with open(args.key_file) as f:
            key = f.read()
    if not key:
        die("need --key or --key-file")
    try:
        name = runvcheck.username(args.name)
        mail = runvcheck.email(args.email)
        key, fingerprint = runvcheck.ssh_key(key)
    except ValueError as e:
        die(str(e))
    create(conf, db, name, mail, key, fingerprint)


def create(conf, db, name, mail, key, fingerprint):
    """Make the account. Also used by runv-queue approve."""
    if find(db, name) or exists_on_system(name):
        die(f"{name} is taken")

    m = conf["members"]
    uid = next_uid(m.getint("uid_min"))
    run("useradd", "--create-home", "--skel", m["skel"], "--shell", m["shell"],
        "--uid", str(uid), "--user-group", "--groups", m["group"], name)
    try:
        home = pwd.getpwnam(name).pw_dir
        os.chmod(home, 0o711)

        ssh = os.path.join(home, ".ssh")
        os.makedirs(ssh, mode=0o700, exist_ok=True)
        with open(os.path.join(ssh, "authorized_keys"), "w") as f:
            f.write(key + "\n")
        os.chmod(os.path.join(ssh, "authorized_keys"), 0o600)
        run("chown", "-R", f"{name}:{name}", ssh)

        write_slice(uid, conf["limits"])
        q = conf["limits"]
        run("setquota", "-u", name, q["quota_soft"], q["quota_hard"], "0", "0", "/")
    except Exception:
        # half an account is worse than none, the home is brand new so -r is fine
        run("userdel", "--remove", name, check=False)
        drop_slice(uid)
        raise

    db.append({
        "username": name,
        "uid": uid,
        "email": mail,
        "key_fingerprint": fingerprint,
        "status": "active",
        "created_at": now().isoformat(),
    })
    save_db(db)
    gemini_sync(db)
    if i2p_sync(db):
        save_db(db)
    try:
        forgejo_add(name, mail, key)
    except Exception as e:
        print(f"warning: no git account yet ({e}). run: runv-user forgejo {name}", file=sys.stderr)
    try:
        irc_add(name)
    except Exception as e:
        print(f"warning: no bouncer account yet ({e}). run: runv-user irc {name}", file=sys.stderr)
    log(f"add {name} uid={uid} key={fingerprint}")

    sent = runvmail.send(mail, "Welcome to runv.club", welcome_text(name, find(db, name).get("i2p")))
    print(f"{name} created (uid {uid}, {fingerprint})" + ("" if sent else ", welcome mail not sent"))


def cmd_list(args, conf, db):
    if not db:
        print("no members yet")
        return
    for m in sorted(db, key=lambda m: m["created_at"]):
        print(f"{m['username']:<16} {m['status']:<10} {m['created_at'][:10]}  {m['email']}")


def cmd_show(args, conf, db):
    m = member_or_die(db, args.name)
    print(json.dumps(m, indent=2, sort_keys=True))


def cmd_suspend(args, conf, db):
    m = member_or_die(db, args.name, "active")
    run("usermod", "--lock", "--expiredate", "1", m["username"])
    stop_sessions(m["username"])
    # web, gemini and gopher can't get in anymore
    os.chmod(pwd.getpwnam(m["username"]).pw_dir, 0o700)
    m["status"] = "suspended"
    m["suspended_at"] = now().isoformat()
    if args.reason:
        m["suspend_reason"] = args.reason
    save_db(db)
    gemini_sync(db)
    i2p_sync(db)
    services_off(m["username"])
    log(f"suspend {m['username']} reason={args.reason or '-'}")
    print(f"{m['username']} suspended")


def cmd_unsuspend(args, conf, db):
    m = member_or_die(db, args.name, "suspended")
    run("usermod", "--unlock", "--expiredate", "", m["username"])
    os.chmod(pwd.getpwnam(m["username"]).pw_dir, 0o711)
    m["status"] = "active"
    m.pop("suspended_at", None)
    m.pop("suspend_reason", None)
    save_db(db)
    gemini_sync(db)
    i2p_sync(db)
    services_on(m["username"])
    log(f"unsuspend {m['username']}")
    print(f"{m['username']} active again")


def cmd_delete(args, conf, db):
    m = member_or_die(db, args.name, "active", "suspended")
    name = m["username"]
    home = pwd.getpwnam(name).pw_dir
    busy = mounts_under(home)
    if busy:
        die(f"something is mounted under {home}: {', '.join(busy)}. unmount it first, no lazy umount")

    run("usermod", "--lock", "--expiredate", "1", name)
    stop_sessions(name)
    gemini_unmount(name)
    services_off(name)

    quarantine = conf["delete"]["quarantine"]
    stamp = now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(quarantine, f"{name}-{stamp}")
    os.rename(home, dest)
    if i2p_tunnel_off(name):
        i2p_reload()
    if os.path.exists(i2p_key(name)):
        shutil.move(i2p_key(name), os.path.join(dest, ".i2p-key.dat"))

    run("setquota", "-u", name, "0", "0", "0", "0", "/", check=False)
    run("crontab", "-r", "-u", name, check=False)
    run("userdel", name)
    drop_slice(m["uid"])
    for spool in (f"/var/mail/{name}", f"/var/spool/mail/{name}"):
        if os.path.isfile(spool):
            os.remove(spool)

    m["status"] = "deleted"
    m["deleted_at"] = now().isoformat()
    m["quarantine"] = dest
    save_db(db)
    log(f"delete {name} home moved to {dest}")
    days = conf["delete"].getint("days")
    print(f"{name} deleted, home kept in {dest} for {days} days")


def purge_one(m, db, conf):
    path = m.get("quarantine")
    root = conf["delete"]["quarantine"].rstrip("/") + "/"
    if path and os.path.exists(path):
        if not path.startswith(root):
            die(f"refusing to remove {path}, it is outside {root}")
        busy = mounts_under(path)
        if busy:
            die(f"something is mounted under {path}: {', '.join(busy)}")
        shutil.rmtree(path)
    try:
        forgejo_remove(m["username"])
    except Exception as e:
        die(f"could not remove the git account of {m['username']}: {e}")
    linkding_remove(m["username"])
    if runvirc.available():
        runvirc.delete(m["username"])
    db.remove(m)
    log(f"purge {m['username']}")
    print(f"{m['username']} purged")


def cmd_purge(args, conf, db):
    if args.now:
        purge_one(member_or_die(db, args.now, "deleted"), db, conf)
        save_db(db)
        return
    days = conf["delete"].getint("days")
    cutoff = now() - dt.timedelta(days=days)
    due = [m for m in db if m["status"] == "deleted"
           and dt.datetime.fromisoformat(m["deleted_at"]) < cutoff]
    for m in due:
        purge_one(m, db, conf)
    if due:
        save_db(db)


def cmd_gemini_sync(args, conf, db):
    for line in gemini_sync(db):
        print(line)


def cmd_forgejo(args, conf, db):
    m = member_or_die(db, args.name, "active")
    with open(os.path.join(pwd.getpwnam(m["username"]).pw_dir, ".ssh", "authorized_keys")) as f:
        key = f.readline().strip()
    print(f"{m['username']}: {forgejo_add(m['username'], m['email'], key)}")


def cmd_irc(args, conf, db):
    m = member_or_die(db, args.name, "active")
    print(f"{m['username']}: {irc_add(m['username'])}")


def cmd_i2p_sync(args, conf, db):
    if i2p_sync(db):
        save_db(db)


def main():
    if os.geteuid() != 0:
        die("run me as root")
    p = argparse.ArgumentParser(prog="runv-user")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add")
    a.add_argument("name")
    a.add_argument("--email", required=True)
    a.add_argument("--key")
    a.add_argument("--key-file")

    sub.add_parser("list")
    for c in ("show", "unsuspend", "delete", "forgejo", "irc"):
        sub.add_parser(c).add_argument("name")
    s = sub.add_parser("suspend")
    s.add_argument("name")
    s.add_argument("--reason")
    sub.add_parser("gemini-sync")
    sub.add_parser("i2p-sync")
    pu = sub.add_parser("purge")
    pu.add_argument("--now", metavar="NAME")

    args = p.parse_args()
    conf = load_conf()
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        db = load_db()
        globals()[f"cmd_{args.cmd.replace('-', '_')}"](args, conf, db)


if __name__ == "__main__":
    main()
