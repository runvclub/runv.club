def cmd_quota_sync(args, conf, db):
    """Every member's quota as runv.conf says, for when the limits change."""
    import csv
    q = conf["limits"]
    want = [q["quota_soft"], q["quota_hard"], q.get("inodes_soft", "0"), q.get("inodes_hard", "0")]
    out = run("repquota", "-u", "-O", "csv", "/").stdout.splitlines()
    have = {r["User"]: [r["BlockSoftLimit"], r["BlockHardLimit"], r["FileSoftLimit"], r["FileHardLimit"]]
            for r in csv.DictReader(out)}
    for m in db:
        if m["status"] in ("active", "suspended") and have.get(m["username"]) != want:
            set_quota(m["username"], conf)
            print(f"changed {m['username']}")


def cmd_i2p_sync(args, conf, db):
    if i2p_sync(db):
        save_db(db)


def main():
    if os.geteuid() != 0:
        die("run me as root")
    p = argparse.ArgumentParser(prog="runv-user")
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add")
    a.add_argument("name")
    a.add_argument("--email", required=True)
    a.add_argument("--key")
    a.add_argument("--key-file")

    sub.add_parser("list")
    for c in ("show", "unsuspend", "delete", "forgejo", "irc"):
        sub.add_parser(c).add_argument("name")
    s = sub.add_parser("suspend")
    s.add_argument("name")
    s.add_argument("--reason")
    sub.add_parser("gemini-sync")
    sub.add_parser("i2p-sync")
    sub.add_parser("quota-sync")
    sub.add_parser("mail-sync")
    pu = sub.add_parser("purge")
    pu.add_argument("--now", metavar="NAME")

    args = p.parse_args()
    conf = load_conf()
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        db = load_db()
        globals()[f"cmd_{args.cmd.replace('-', '_')}"](args, conf, db)


if __name__ == "__main__":
    main()
