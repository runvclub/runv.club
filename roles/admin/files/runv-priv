#!/usr/bin/python3 -I
# the few things a member needs root for, run through sudo by `runv`.
# it only ever acts on the member who called it (SUDO_USER) and takes no
# free-form arguments.
#
#   runv-priv whoami        the member's own record, as json
#   runv-priv token irc     new password for the irc bouncer
#   runv-priv token ntfy    new token for ntfy.runv.club
#   runv-priv board new|reply N   post to the board, text on stdin
#   runv-priv guestbook ACTION [N]   moderate your own guestbook
#   runv-priv write NAME    a message to another member's terminal, on
#                           stdin. NAME must be an active member
import argparse
import json
import os
import pwd
import re
import secrets
import stat
import subprocess
import sys

sys.path.insert(0, "/usr/local/lib/runv")
import runvirc  # noqa: E402
import runvsecret  # noqa: E402

DB = "/var/lib/runv/members.json"


def die(msg):
    print(f"runv: {msg}", file=sys.stderr)
    sys.exit(1)


def caller():
    name = os.environ.get("SUDO_USER", "")
    try:
        with open(DB) as f:
            db = json.load(f)
    except FileNotFoundError:
        db = []
    for m in db:
        if m["username"] == name and m["status"] == "active":
            if pwd.getpwnam(name).pw_uid != m["uid"]:
                break
            return m
    die("this only works for runv.club members")


def token_irc(m):
    if not runvirc.available():
        die("the irc bouncer isn't set up yet")
    name = m["username"]
    password = runvirc.new_password(name) if runvirc.exists(name) else runvirc.create(name)
    return password, runvsecret.save(name, "irc-token", password)


def ntfy(*args, env=None):
    # as ntfy's own user, so its database never ends up owned by root
    return subprocess.run(["runuser", "-u", "_ntfy", "--", "ntfy", *args],
                          capture_output=True, text=True, env=env)


def token_ntfy(m):
    if not os.path.exists("/usr/bin/ntfy"):
        die("ntfy isn't set up yet")
    name = m["username"]
    # a new token means a fresh user: the old token dies with the old one
    ntfy("user", "remove", name)
    env = dict(os.environ, NTFY_PASSWORD=secrets.token_urlsafe(24))
    for args in (("user", "add", name), ("access", name, f"{name}-*", "rw")):
        out = ntfy(*args, env=env)
        if out.returncode != 0:
            die("ntfy said no: " + (out.stderr or out.stdout).strip()[:200])
    out = ntfy("token", "add", name)
    token = next((w for w in (out.stdout + out.stderr).split() if w.startswith("tk_")), None)
    if not token:
        die("ntfy didn't hand out a token")
    return token, runvsecret.save(name, "ntfy-token", token)


BOARD = "/var/lib/runv-board/board.db"


def board(m, action, thread):
    import datetime as dt
    import sqlite3
    text = sys.stdin.read(20_000).strip()
    if not text:
        die("empty post")
    os.makedirs(os.path.dirname(BOARD), mode=0o755, exist_ok=True)
    c = sqlite3.connect(BOARD)
    c.executescript("""
        create table if not exists threads (id integer primary key, title, author, created);
        create table if not exists posts (id integer primary key, thread, author, created, body);
    """)
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
    if action == "new":
        title, _, body = text.partition("\n")
        title = title.strip()[:120]
        if not title:
            die("the first line is the title")
        thread = c.execute("insert into threads (title, author, created) values (?, ?, ?)",
                           (title, m["username"], now)).lastrowid
        text = body.strip() or title
    elif not c.execute("select 1 from threads where id = ?", (thread,)).fetchone():
        die("no such thread")
    c.execute("insert into posts (thread, author, created, body) values (?, ?, ?, ?)",
              (thread, m["username"], now, text))
    c.commit()
    os.chmod(BOARD, 0o644)
    print(f"posted. board read {thread}")


def guestbook(m, action, note):
    # as the guestbook's own user, so its database never ends up owned by root
    cmd = ["runuser", "-u", "runvgb", "--", "python3", "-I", "/usr/local/lib/runv-guestbook/gbctl.py",
           m["username"], action] + ([str(note)] if note is not None else [])
    if not os.path.exists(cmd[6]):
        die("guestbooks aren't set up yet")
    sys.exit(subprocess.run(cmd).returncode)


def strip_controls(line):
    # nothing that a terminal would act on: no escapes, no bidi tricks
    return "".join(c for c in line if c == "\t" or (c.isprintable() and not "\u202a" <= c <= "\u202e"
                                                    and not "\u2066" <= c <= "\u2069"))


def write_to(m, to):
    """Debian dropped write(1) and utmp, so this is ours. The target's
    terminals are the ptys they own, and mesg y is the group write bit on
    them, like it always was. The most recently used one gets the message."""
    import time
    sender = m["username"]
    if not re.fullmatch(r"[a-z][a-z0-9_]{1,15}", to or ""):
        die("write to whom?")
    with open(DB) as f:
        target = next((x for x in json.load(f) if x["username"] == to and x["status"] == "active"), None)
    if not target:
        die(f"{to} isn't a runv.club member")
    ttys, muted = [], False
    for e in os.listdir("/dev/pts"):
        if not e.isdigit():
            continue
        try:
            st = os.stat(os.path.join("/dev/pts", e))
        except OSError:
            continue
        if not stat.S_ISCHR(st.st_mode) or st.st_uid != target["uid"]:
            continue
        if st.st_mode & stat.S_IWGRP:
            ttys.append((st.st_atime, e, st.st_rdev))
        else:
            muted = True
    if not ttys:
        die(f"{to} has messages turned off" if muted else f"{to} isn't logged in")

    # five messages a minute is plenty for a person
    os.makedirs("/run/runv-write", mode=0o700, exist_ok=True)
    log, now = os.path.join("/run/runv-write", sender), time.time()
    try:
        with open(log) as f:
            recent = [float(t) for t in f.read().split() if now - float(t) < 60]
    except (OSError, ValueError):
        recent = []
    if len(recent) >= 5:
        die("slow down, try again in a minute")
    with open(log, "w") as f:
        f.write(" ".join(str(t) for t in recent + [now]))

    text = sys.stdin.buffer.read(4000).decode("utf-8", "replace")
    lines = [strip_controls(l)[:300] for l in text.replace("\r", "").split("\n")]
    while lines and not lines[-1].strip():
        lines.pop()
    if not lines:
        die("empty message")
    lines = lines[:20]

    _, pts, rdev = max(ttys)
    path = os.path.join("/dev/pts", pts)
    fd = os.open(path, os.O_WRONLY | os.O_NOCTTY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if st.st_rdev != rdev or st.st_uid != target["uid"] or not st.st_mode & stat.S_IWGRP:
            die(f"{to} isn't logged in")
        head = f"Message from {sender}@runv.club at {time.strftime('%H:%M')} ..."
        os.write(fd, ("\n\a" + head + "\n" + "\n".join(lines) + "\nEOF\n").encode())
    except BlockingIOError:
        die(f"{to}'s terminal isn't taking anything right now")
    finally:
        os.close(fd)


def main():
    if os.geteuid() != 0:
        die("run this through runv")
    p = argparse.ArgumentParser(prog="runv-priv")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("whoami")
    t = sub.add_parser("token")
    t.add_argument("service", choices=["irc", "ntfy"])
    b = sub.add_parser("board")
    b.add_argument("action", choices=["new", "reply"])
    b.add_argument("thread", nargs="?", type=int)
    g = sub.add_parser("guestbook")
    g.add_argument("action", choices=["list", "all", "on", "off", "ok", "rm", "ban"])
    g.add_argument("note", nargs="?", type=int)
    w = sub.add_parser("write")
    w.add_argument("to")
    args = p.parse_args()

    m = caller()
    if args.cmd == "guestbook":
        guestbook(m, args.action, args.note)
    if args.cmd == "write":
        write_to(m, args.to)
        return
    if args.cmd == "board":
        if args.action == "reply" and not args.thread:
            die("reply to which thread?")
        board(m, args.action, args.thread)
        return
    if args.cmd == "whoami":
        print(json.dumps({k: m.get(k) for k in ("username", "created_at", "status", "i2p")}))
        return
    token, where = {"irc": token_irc, "ntfy": token_ntfy}[args.service](m)
    print(json.dumps({"token": token, "saved": where}))


if __name__ == "__main__":
    main()
