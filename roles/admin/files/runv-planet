#!/usr/bin/python3 -I
# every 15 minutes: the latest posts of every active member, at
# runv.club/planet, as a feed and as a short list on the home page. also
# the member directory at runv.club/~, who changed their page in the last
# day (also as a feed at /updated.xml), the webring at /ring and /tilde.json
import html
import json
import os
import pwd
import stat
import time
import xml.etree.ElementTree as ET

MEMBERS = "/var/lib/runv/members.json"
OUT = "/var/www/runv/planet"
A = "{http://www.w3.org/2005/Atom}"
CSS = """html { background: #fff; color: #000; }
body { max-width: 34rem; margin: 0 auto; padding: 4rem 1.25rem;
  font: 1.125rem/1.7 Georgia, "Times New Roman", serif; }
h1 { font-size: 1.5rem; font-weight: normal; margin: 0 0 2rem; }
h2 { font-size: 1.125rem; font-weight: bold; margin: 2rem 0 .75rem; }
a { color: #000; }
ul { list-style: none; padding: 0; }
li { margin: 0 0 .75rem; }
.who { color: #555; }
footer { margin-top: 3rem; font-size: 1rem; }"""


def feed_of(name, uid):
    path = os.path.join(pwd.getpwnam(name).pw_dir, "public_html", "blog", "atom.xml")
    try:
        # a member's feed must be a real file of theirs, not a link to something
        # else, and not a fifo that would leave us waiting forever
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return []
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 512 * 1024:
            return []
        try:
            root = ET.fromstring(f.read())
        except ET.ParseError:
            return []
    prefix = f"https://runv.club/~{name}/"
    posts = []
    for e in root.findall(f"{A}entry"):
        link = e.find(f"{A}link")
        url = link.get("href", "") if link is not None else ""
        if not url.startswith(prefix):
            continue
        posts.append({"who": name, "title": (e.findtext(f"{A}title") or "untitled")[:200],
                      "url": url, "date": (e.findtext(f"{A}updated") or "")[:10]})
    return posts


def last_change(home):
    """Newest mtime under ~/public_html, without following links. Capped, so
    a member with a million files can't make this slow."""
    newest, seen = 0, 0
    top = os.path.join(home, "public_html")
    if os.path.islink(top):
        return 0
    # a date in the future would keep someone at the top of the list
    later = time.time() + 300
    for root, dirs, files in os.walk(top, followlinks=False):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        seen += 1
        if seen > 5000:
            return newest
        for f in files:
            try:
                mtime = os.lstat(os.path.join(root, f)).st_mtime
                if mtime < later:
                    newest = max(newest, mtime)
            except OSError:
                pass
            seen += 1
            if seen > 5000:
                return newest
    return newest


def directory(members):
    import datetime as dt
    rows = []
    for m in members:
        name = m["username"]
        home = pwd.getpwnam(name).pw_dir
        rows.append((last_change(home), name, (m.get("created_at") or "")[:10]))
    rows.sort(reverse=True)

    def li(changed, name, joined):
        when = dt.datetime.fromtimestamp(changed).strftime("%Y-%m-%d") if changed else "-"
        return (f'<li><a href="/~{name}/">~{name}</a> <span class="who">updated {when}'
                f'{", joined " + joined if joined else ""}</span></li>')

    items = "\n".join(li(*r) for r in rows) or "<li>nobody yet</li>"
    now = dt.datetime.now().timestamp()
    recent = [r for r in rows if r[0] > now - 86400]
    lately = ""
    if recent:
        lately = ("<h2>Updated in the last 24 hours</h2>\n<ul>\n"
                  + "\n".join(f'<li><a href="/~{n}/">~{n}</a></li>' for _, n, _ in recent) + "\n</ul>\n"
                  + "<h2>Everyone</h2>\n")
    stamp = lambda t: dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    entries = "".join(
        f"<entry><title>~{n} updated their page</title><link href=\"https://runv.club/~{n}/\"/>"
        f"<id>https://runv.club/~{n}/#{stamp(t)}</id><updated>{stamp(t)}</updated>"
        f"<author><name>{n}</name></author></entry>" for t, n, _ in recent)
    write(os.path.join("/var/www/runv", "updated.xml"), '<?xml version="1.0" encoding="utf-8"?>\n'
          '<feed xmlns="http://www.w3.org/2005/Atom"><title>runv.club, updated lately</title>'
          '<link href="https://runv.club/~/"/><id>https://runv.club/updated.xml</id>'
          f"<updated>{stamp(recent[0][0] if recent else now)}</updated>{entries}</feed>\n")
    write(os.path.join("/var/www/runv", "members.html"), f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>runv.club members</title>
<link rel="alternate" type="application/atom+xml" title="updated lately" href="/updated.xml">
<style>
{CSS}
</style>
</head>
<body>
<h1>~ members</h1>
<p>{len(rows)} {"person lives" if len(rows) == 1 else "people live"} on runv.club. Newest changes first.</p>
{lately}<ul>
{items}
</ul>
<footer><a href="/">runv.club</a> · <a href="/planet/">planet</a> · <a href="/ring/">ring</a> · <a href="/updated.xml">feed</a></footer>
</body>
</html>
""")


def in_ring(name, uid):
    """~/.ring is the opt-in: a plain file of theirs, never a link."""
    try:
        st = os.lstat(os.path.join(pwd.getpwnam(name).pw_dir, ".ring"))
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == uid


def ring(members):
    """Static pages only: /ring/NAME/next.html and prev.html send you on."""
    import shutil
    out = "/var/www/runv/ring"
    names = [m["username"] for m in sorted(members, key=lambda m: (m.get("created_at") or "", m["username"]))
             if in_ring(m["username"], m["uid"])]
    os.makedirs(out, mode=0o755, exist_ok=True)

    def hop(to):
        return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=/~{to}/">
<title>runv ring</title>
</head>
<body><p><a href="/~{to}/">on to ~{to}</a></p></body>
</html>
"""
    for i, name in enumerate(names):
        os.makedirs(os.path.join(out, name), mode=0o755, exist_ok=True)
        write(os.path.join(out, name, "next.html"), hop(names[(i + 1) % len(names)]))
        write(os.path.join(out, name, "prev.html"), hop(names[i - 1]))
    for d in os.listdir(out):
        if d not in names and os.path.isdir(os.path.join(out, d)) and not os.path.islink(os.path.join(out, d)):
            shutil.rmtree(os.path.join(out, d))
    items = "\n".join(f'<li><a href="/~{n}/">~{n}</a></li>' for n in names) or "<li>nobody yet</li>"
    write(os.path.join(out, "index.html"), f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>runv ring</title>
<style>
{CSS}
</style>
</head>
<body>
<h1>runv ring</h1>
<p>A webring of runv.club members. Each page links to the next one and the one before, all the way around. Members join with <code>touch ~/.ring</code>, and <code>help ring</code> has the links to put on your page.</p>
<ul>
{items}
</ul>
<footer><a href="/">runv.club</a> · <a href="/~">members</a></footer>
</body>
</html>
""")


def write(path, text):
    with open(path + ".new", "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(path + ".new", 0o644)
    os.replace(path + ".new", path)


def main():
    try:
        with open(MEMBERS) as f:
            members = [m for m in json.load(f) if m["status"] == "active"]
    except FileNotFoundError:
        members = []
    posts = []
    for m in members:
        posts += feed_of(m["username"], m["uid"])
    tilde = {"name": "runv.club", "url": "https://runv.club/", "signup_url": "https://runv.club/join",
             "want_users": True, "admin_email": "admin@runv.club",
             "description": "A small public unix server from Brazil, in English.",
             "users": sorted(m["username"] for m in members)}
    write("/var/www/runv/tilde.json", json.dumps(tilde, indent=2) + "\n")
    directory(members)
    ring(members)
    posts.sort(key=lambda p: p["date"], reverse=True)
    posts = posts[:50]
    os.makedirs(OUT, mode=0o755, exist_ok=True)

    def li(p):
        return (f'<li><a href="{html.escape(p["url"])}">{html.escape(p["title"])}</a> '
                f'<span class="who">~{p["who"]}, {p["date"]}</span></li>')

    items = "\n".join(li(p) for p in posts) or "<li>no posts yet</li>"
    write(os.path.join(OUT, "index.html"), f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>planet runv</title>
<link rel="alternate" type="application/atom+xml" href="/planet/atom.xml">
<style>
{CSS}
</style>
</head>
<body>
<h1>planet runv</h1>
<p>What the members of runv.club wrote lately.</p>
<ul>
{items}
</ul>
<footer><a href="/">runv.club</a> · <a href="/planet/atom.xml">feed</a></footer>
</body>
</html>
""")
    latest = "\n".join(li(p) for p in posts[:5])
    write(os.path.join(OUT, "latest.html"),
          f'<h2>Lately on the planet</h2>\n<ul class="planet">\n{latest}\n</ul>\n<p><a href="/planet/">More posts</a></p>\n'
          if posts else "")
    entries = "".join(
        f"<entry><title>{html.escape(p['title'])} (~{p['who']})</title><link href=\"{html.escape(p['url'])}\"/>"
        f"<id>{html.escape(p['url'])}</id><updated>{p['date'] or '2026-01-01'}T12:00:00Z</updated>"
        f"<author><name>{p['who']}</name></author></entry>" for p in posts)
    write(os.path.join(OUT, "atom.xml"), '<?xml version="1.0" encoding="utf-8"?>\n'
          '<feed xmlns="http://www.w3.org/2005/Atom"><title>planet runv</title>'
          '<link href="https://runv.club/planet/"/><id>https://runv.club/planet/</id>'
          f"<updated>{(posts[0]['date'] if posts else '2026-01-01')}T12:00:00Z</updated>{entries}</feed>\n")


if __name__ == "__main__":
    main()
