#!/usr/bin/python3 -I
# board: a small forum for the members, in the terminal.
#
#   board              the latest threads
#   board read N       a thread
#   board new          start a thread (opens your editor)
#   board reply N      answer one
#
# posts go through runv-priv, so nobody can edit what others wrote
import os
import sqlite3
import subprocess
import sys
import tempfile

sys.path.insert(0, "/usr/local/lib/runv")
from runvtext import clean  # noqa: E402

DB = "/var/lib/runv-board/board.db"


def db():
    if not os.path.exists(DB):
        sys.exit("board: nothing here yet. be the first: board new")
    return sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=5)


def edit(template):
    editor = os.environ.get("EDITOR", "nano")
    with tempfile.NamedTemporaryFile("w+", suffix=".txt") as f:
        f.write(template)
        f.flush()
        subprocess.run([editor, f.name])
        f.seek(0)
        lines = [l for l in f.read().splitlines() if not l.startswith("#")]
    return "\n".join(lines).strip()


def send(args, text):
    out = subprocess.run(["sudo", "-n", "/usr/local/sbin/runv-priv", "board", *args],
                         input=text, capture_output=True, text=True)
    print((out.stdout or out.stderr).strip().removeprefix("runv: "))


def main():
    a = sys.argv[1:]
    if not a:
        rows = db().execute(
            "select t.id, t.title, t.author, count(p.id), max(p.created) from threads t "
            "join posts p on p.thread = t.id group by t.id order by max(p.created) desc limit 30").fetchall()
        # posts from before the cleaning on the way in get cleaned here
        for tid, title, author, n, last in rows:
            print(f"{tid:>4}  {clean(title, 1)[:46]:<46} {author:<12} {n - 1:>3} replies  {last[:10]}")
        print("\nboard read N · board new · board reply N")
    elif a[0] == "read" and len(a) == 2 and a[1].isdigit():
        c = db()
        t = c.execute("select title from threads where id = ?", (int(a[1]),)).fetchone()
        if not t:
            sys.exit("board: no such thread")
        print(f"# {clean(t[0], 1)}\n")
        for author, created, body in c.execute(
                "select author, created, body from posts where thread = ? order by id", (int(a[1]),)):
            print(f"~{author}, {created[:16].replace('T', ' ')}\n{clean(body)}\n")
    elif a == ["new"]:
        text = edit("# first line is the title, the rest is the post\n\n")
        if text:
            send(["new"], text)
    elif a[0] == "reply" and len(a) == 2 and a[1].isdigit():
        text = edit("# your reply\n\n")
        if text:
            send(["reply", a[1]], text)
    else:
        print("usage: board | board read N | board new | board reply N")


if __name__ == "__main__":
    try:
        main()
    except sqlite3.OperationalError:
        sys.exit("board: busy right now, try again in a moment")
