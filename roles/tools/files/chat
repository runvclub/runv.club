#!/bin/sh
# senpai through the runv.club bouncer, which keeps you in #runv on
# tilde.chat while you're away. the same account works in the browser at
# https://chat.runv.club, and BouncerServ adds other networks.
# `chat weechat` skips the bouncer and opens weechat straight on tilde.chat.
set -eu
token="$HOME/.config/runv/irc-token"
conf="${XDG_CONFIG_HOME:-$HOME/.config}/senpai/senpai.scfg"

if [ "${1:-}" = weechat ]; then
    shift
    wconf="${XDG_CONFIG_HOME:-$HOME/.config}/weechat/irc.conf"
    if [ -f "$wconf" ] && grep -q '^tilde\.addresses' "$wconf"; then
        exec weechat "$@"
    fi
    exec weechat -r "/server add tilde irc.tilde.chat/6697 -tls;\
/set irc.server.tilde.nicks $USER;\
/set irc.server.tilde.username $USER;\
/set irc.server.tilde.realname $USER@runv.club;\
/set irc.server.tilde.autojoin #runv;\
/set irc.server.tilde.autoconnect on;\
/save;\
/connect tilde" "$@"
fi

[ -s "$token" ] || runv token irc >/dev/null

if [ ! -f "$conf" ]; then
    mkdir -p "$(dirname "$conf")"
    cat > "$conf" <<END
address irc.runv.club:6697
nickname $USER
username $USER
realname "$USER@runv.club"
password-cmd cat "$token"
END
fi
exec senpai "$@"
