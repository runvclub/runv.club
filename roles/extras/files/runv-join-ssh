#!/usr/bin/python3 -I
# what `ssh join@runv.club` runs: the signup form, asked one question at a
# time, sent to the same form the website uses. so it has the same checks,
# the same line and the same weekly limit.
import html
import json
import os
import re
import signal
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/runv")
import runvcheck  # noqa: E402

FORM = "http://127.0.0.1:8001/join"
RATE = os.path.expanduser("~/rate.json")
PER_ADDR, PER_DAY = 3, 30


def out(text=""):
    print(text, flush=True)


def ask(prompt, check=None, multiline=False):
    while True:
        if multiline:
            out(prompt + " (an empty line ends it)")
            lines = []
            while True:
                line = input("  ")
                if not line.strip():
                    break
                lines.append(line)
            value = "\n".join(lines).strip()
        else:
            value = input(prompt + " ").strip()
        if not check:
            return value
        try:
            return check(value)
        except ValueError as e:
            out(f"  {e}")


def about_check(text):
    if not 0 < len(text) <= 2000:
        raise ValueError("Between 1 and 2000 characters, please.")
    return text


def allowed(addr):
    now = time.time()
    try:
        with open(RATE) as f:
            seen = {k: [t for t in v if now - t < 86400] for k, v in json.load(f).items()}
    except (OSError, ValueError):
        seen = {}
    mine = [t for t in seen.get(addr, []) if now - t < 3600]
    if len(mine) >= PER_ADDR or sum(len(v) for v in seen.values()) >= PER_DAY:
        return False
    seen.setdefault(addr, []).append(now)
    with open(RATE + ".new", "w") as f:
        json.dump(seen, f)
    os.replace(RATE + ".new", RATE)
    return True


def main():
    signal.alarm(900)
    addr = os.environ.get("SSH_CLIENT", "?").split()[0]
    out("\nrunv.club, a small public unix server.\n")
    try:
        with urllib.request.urlopen(FORM, timeout=10) as r:
            page = r.read().decode()
    except (urllib.error.URLError, OSError):
        out("The signup form is down right now. Try https://runv.club/join later.")
        return
    t = re.search(r'name="t" value="([^"]+)"', page)
    if not t:
        out("Signups are closed right now. Keep an eye on https://runv.club/")
        return
    out("Every request is read by a person, and 5 people get in each week.")
    out("Read the rules first: https://runv.club/rules\n")

    name = ask("Username you want:", runvcheck.username)
    mail = ask("Your email (only used to write to you about the account):", runvcheck.email)
    key = ask("Your SSH public key, the whole line from your .pub file:", lambda k: runvcheck.ssh_key(k)[0])
    about = ask("What do you want to do here? A few lines is plenty.", about_check, multiline=True)
    former = ask("Were you on the old runv.club? (y/n)").lower().startswith("y")
    if not ask("Do you accept the rules? (y/n)").lower().startswith("y"):
        out("No problem. Bye!")
        return
    if not allowed(addr):
        out("Too many requests from here for now. Try again later.")
        return

    data = {"t": t.group(1), "username": name, "email": mail, "key": key, "about": about, "rules": "on"}
    if former:
        data["former"] = "on"

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k):
            return None

    req = urllib.request.Request(FORM, urllib.parse.urlencode(data).encode(),
                                 headers={"X-Forwarded-For": addr})
    try:
        urllib.request.build_opener(NoRedirect).open(req, timeout=20)
        out("Something unexpected happened. Try https://runv.club/join instead.")
    except urllib.error.HTTPError as e:
        if e.code == 303:
            out("\nDone, you're in line. Your status page:")
            out("  https://runv.club" + e.headers["Location"])
            out("We also sent it to your email. See you soon!")
        else:
            body = e.read().decode(errors="replace")
            box = re.search(r'<div class="errors">(.*?)</div>', body, re.S)
            errors = re.findall(r"<p>(.*?)</p>", box.group(1)) if box else []
            out("\nThat didn't go through:")
            for err in errors or ["the form said no, try https://runv.club/join"]:
                out("  " + html.unescape(err))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        out("\nBye!")
