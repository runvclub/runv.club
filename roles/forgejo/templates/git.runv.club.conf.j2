server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name git.runv.club;

    ssl_certificate     /etc/letsencrypt/live/runv.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runv.club/privkey.pem;
    include snippets/runv-headers.conf;

    client_max_body_size 50m;

    location = /user/login {
        limit_req zone=git_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
