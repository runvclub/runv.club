[Unit]
Description=Forgejo (git.runv.club)
After=network.target

[Service]
# members can make these fetch urls (webhooks, feeds, bookmarks), and the
# firewall rules for members don't cover service users: no tailnet, no
# cloud metadata
IPAddressDeny=100.64.0.0/10 169.254.0.0/16 fd7a:115c:a1e0::/48
User=git
Group=git
WorkingDirectory=/var/lib/forgejo
Environment=USER=git HOME=/var/lib/forgejo FORGEJO_WORK_DIR=/var/lib/forgejo
ExecStart=/usr/local/bin/forgejo web --config /etc/forgejo/app.ini
Restart=always

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/forgejo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
