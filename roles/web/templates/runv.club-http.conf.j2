server {
    listen 80;
    listen [::]:80;
    server_name runv.club www.runv.club;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
{% if have_cert %}
        return 301 https://runv.club$request_uri;
{% else %}
        root /var/www/runv;
        try_files $uri /index.html;
{% endif %}
    }
}
