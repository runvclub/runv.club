server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.runv.club;

    ssl_certificate     /etc/letsencrypt/live/runv.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runv.club/privkey.pem;
    include snippets/runv-headers.conf;

    return 301 https://runv.club$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name runv.club;

    ssl_certificate     /etc/letsencrypt/live/runv.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runv.club/privkey.pem;
    include snippets/runv-headers.conf;

    root /var/www/runv;
    index index.html;
    autoindex off;
    disable_symlinks if_not_owner;

    # the home page pulls in the latest planet posts
    location = /index.html {
        ssi on;
    }

    # the member directory
    location ~ ^/~/?$ {
        try_files /members.html =404;
    }

    location = /farewell {
        try_files /farewell.html =404;
    }

    # where the home page sat before it took over /
    location = /new {
        return 301 /;
    }

    location = /rules {
        try_files /rules.html =404;
    }

    location = /privacy {
        try_files /privacy.html =404;
    }

    location = /about {
        try_files /about.html =404;
    }

    # the help topics, made by runv-help-web
    location = /help {
        return 301 /help/;
    }

    location /help/ {
        try_files $uri $uri.html $uri/ =404;
        error_page 404 /404;
    }

    # ~user pages straight from the home dir. a member can't symlink their
    # way into files they don't own, and 403s look like 404s from outside
    location ~ "^/~(?<member>[a-z][a-z0-9_]{1,15})(?<rest>/.*)?$" {
        access_log /var/log/nginx/members.log runv_members;
        if ($rest = "") {
            return 301 /~$member/;
        }
        # a copied ~/.ssh or a whole repo in public_html is an accident
        if ($rest ~ "/\.(git|ssh|gnupg)(/|$)") {
            return 404;
        }
        alias /home/$member/public_html$rest;
        error_page 403 =404 /404;
        # each member page runs in an origin of its own: scripts work, but
        # they can't read runv.club, use its cookies or post its forms as
        # the visitor. add_header here drops the server's, so they come again
        include snippets/runv-headers.conf;
        add_header Content-Security-Policy "sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox allow-downloads allow-modals" always;
    }

    location = /404 {
        internal;
        return 404 "not found\n";
    }

    location /join {
        limit_req zone=join burst=5 nodelay;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # guestbooks, served by runv-guestbook. it sets its own CSP
    location ^~ /guestbook/ {
        # the server's headers minus frame-ancestors, which the app sets
        # itself (the embed has to be framable by member pages)
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        limit_req zone=gb_post burst=2 nodelay;
        limit_req zone=gb_read burst=20 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ =404;
        error_page 404 /404;
    }
}
