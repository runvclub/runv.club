server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name feeds.runv.club;

    ssl_certificate     /etc/letsencrypt/live/runv.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runv.club/privkey.pem;
    include snippets/runv-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
